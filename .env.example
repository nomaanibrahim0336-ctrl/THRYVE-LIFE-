# Copy to .env and fill in from your Supabase project settings (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — used by the Supabase Edge Function, never shipped in the app.
# Set these with: supabase secrets set ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
